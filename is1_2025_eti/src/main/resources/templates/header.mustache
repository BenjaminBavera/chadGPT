<!DOCTYPE html>
<html lang="es" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema Universitario</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/tailwind.css">


    <script>
        if (localStorage.getItem('tema') === 'oscuro') {
            document.documentElement.classList.add('dark');
        }
    </script>

    <style>
        body { font-family: 'Inter', sans-serif; }
        body { background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%); }
        .dark body { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #f8fafc; }

        .tarjeta-moderna {
            background: rgba(255, 255, 255, 0.98);
            border: 1px solid rgba(226, 232, 240, 0.8);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
            border-radius: 1rem;
        }
        .dark .tarjeta-moderna {
            background: rgba(30, 41, 59, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }
    </style>
</head>
<body class="flex flex-col min-h-screen">

<nav class="bg-blue-700 dark:bg-slate-900 shadow-md sticky top-0 z-50 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">

            <div class="flex items-center gap-3">
                <div class="bg-white/20 p-2 rounded-lg text-white">🎓</div>
                <span class="font-bold text-white text-xl tracking-tight">Sistema Universitario</span>
            </div>

            <div class="flex-1"></div>

            <div class="flex items-center gap-4">

                <div class="flex items-center gap-2 bg-blue-800/50 dark:bg-slate-800 p-1.5 rounded-full border border-blue-600 dark:border-slate-700">
                    <span class="text-xs">☀️</span>
                    <button onclick="toggleTemaGlobal()" id="btn-tema-global" class="relative inline-flex items-center w-10 h-5 rounded-full transition-colors duration-300 focus:outline-none bg-blue-400 dark:bg-indigo-500">
                        <span id="circulo-tema-global" class="inline-block w-3.5 h-3.5 bg-white rounded-full shadow transform translate-x-1"></span>
                    </button>
                    <span class="text-xs">🌙</span>
                </div>

                <a href="/logout" class="bg-red-500/90 hover:bg-red-600 text-white px-4 py-1.5 rounded-md text-sm font-medium shadow-sm transition-colors">
                    Salir
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    function aplicarEstadoTemaGlobal() {
        const btn = document.getElementById('btn-tema-global');
        const circulo = document.getElementById('circulo-tema-global');
        if (!btn || !circulo) return;

        if (localStorage.getItem('tema') === 'oscuro') {
            circulo.classList.remove('translate-x-1');
            circulo.classList.add('translate-x-5');
        } else {
            circulo.classList.remove('translate-x-5');
            circulo.classList.add('translate-x-1');
        }
    }

    function toggleTemaGlobal() {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
            html.classList.remove('dark');
            localStorage.setItem('tema', 'claro');
        } else {
            html.classList.add('dark');
            localStorage.setItem('tema', 'oscuro');
        }
        aplicarEstadoTemaGlobal();
    }

    window.addEventListener('load', () => {
        aplicarEstadoTemaGlobal();
    });
</script>

<main class="flex-1 flex flex-col items-center justify-center p-6 md:p-10 w-full max-w-6xl mx-auto">
{{> header}}
<script>document.title = "Selección de Perfil";</script>

<div class="w-full tarjeta-moderna p-8 max-w-5xl mx-auto">
    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-200 mb-2">¡Hola, {{username}}!</h1>
    <p class="text-gray-600 dark:text-gray-400 text-center mb-8">¿A qué perfil querés ingresar hoy?</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

        <a href="/dashboardEstudiante" class="group relative flex flex-col justify-center items-center bg-blue-50 dark:bg-slate-800/80 border border-blue-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-blue-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
            <h2 class="text-2xl font-bold text-blue-700 dark:text-blue-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Soy Estudiante</h2>
            <div class="relative w-full h-16 flex justify-center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">
                    Ver mis materias, inscribirme y consultar mi estado académico.
                </p>
                <p class="absolute w-full font-semibold text-blue-700 dark:text-blue-300 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">
                    Ingresar como Estudiante
                </p>
            </div>
        </a>

        <a href="/dashboardProfesor" class="group relative flex flex-col justify-center items-center bg-purple-50 dark:bg-slate-800/80 border border-purple-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-purple-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
            <h2 class="text-2xl font-bold text-purple-700 dark:text-purple-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Soy Profesor</h2>
            <div class="relative w-full h-16 flex justify-center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">
                    Gestionar mis cátedras, cargar notas y ver listados de alumnos.
                </p>
                <p class="absolute w-full font-semibold text-purple-700 dark:text-purple-400 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">
                    Ingresar como Profesor
                </p>
            </div>
        </a>

    </div>

    <div class="w-full flex justify-center mt-6">
        <a href="/logout" class="bg-red-600 dark:bg-red-700 text-white py-2 px-6 rounded-md hover:bg-red-700 dark:hover:bg-red-600 transition duration-300 text-lg font-medium">
            Cerrar Sesión
        </a>
    </div>
</div>

{{> footer}}
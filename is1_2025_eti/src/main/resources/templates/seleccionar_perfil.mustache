{{> header}}

<div class="flex flex-col items-center justify-center min-h-[80vh] p-4">
    
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl text-center">
        
        <h1 class="text-3xl font-bold text-gray-900 mb-2">¡Hola, {{username}}!</h1>
        <p class="text-gray-600 mb-8">¿A qué perfil querés ingresar hoy?</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            
            <a href="/dashboardEstudiante" class="group block bg-blue-50 border border-blue-200 p-8 rounded-xl text-center shadow-sm hover:shadow-md hover:bg-blue-100 transition duration-300">
                <div class="mx-auto bg-blue-200 text-blue-700 w-16 h-16 rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg style="width: 32px; height: 32px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v7"></path></svg>
                </div>
                <h2 class="text-2xl font-bold text-blue-800 mb-2">Soy Estudiante</h2>
                <p class="text-blue-600 text-sm">Ver mis materias, inscribirme y consultar mi estado académico.</p>
            </a>

            <a href="/dashboardProfesor" class="group block bg-purple-50 border border-purple-200 p-8 rounded-xl text-center shadow-sm hover:shadow-md hover:bg-purple-100 transition duration-300">
                <div class="mx-auto bg-purple-200 text-purple-700 w-16 h-16 rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg style="width: 32px; height: 32px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                <h2 class="text-2xl font-bold text-purple-800 mb-2">Soy Profesor</h2>
                <p class="text-purple-600 text-sm">Gestionar mis cátedras, cargar notas y ver listados de alumnos.</p>
            </a>

        </div>

        <div class="w-full flex justify-center mt-8 border-t pt-6">
            <a href="/logout" class="text-red-600 hover:text-red-800 font-medium transition duration-300">
                Cancelar y cerrar sesión
            </a>
        </div>
    </div>
</div>

{{> footer}}
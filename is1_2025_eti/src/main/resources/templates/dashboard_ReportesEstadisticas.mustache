{{> header}}

<script>document.title = "Reportes y estadísticas";</script>

<div class="w-full tarjeta-moderna p-8 max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-200 mb-6">Rendimiento Académico</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-gray-700 dark:text-gray-200 mb-8">

        <a href="/reporteRiesgo" class="group relative flex flex-col justify-center items-center bg-red-50 dark:bg-slate-800/80 border border-red-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-red-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
            <h2 class="text-2xl font-bold text-red-700 dark:text-red-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Ver Reporte de Riesgo</h2>
            <div class="relative w-full h-16 flex justify center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">Identifica estudiantes con riesgo de abandono o rezago.</p>
                <p class="absolute w-full font-semibold text-red-600 dark:text-red-300 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">Ver Reporte</p>
            </div>
        </a>
        

        <a href="/alumnosExcelencia" class="group relative flex flex-col justify-center items-center bg-amber-50 dark:bg-slate-800/80 border border-amber-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-amber-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
            <h2 class="text-2xl font-bold text-amber-700 dark:text-amber-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Alumnos de Excelencia</h2>
            <div class="relative w-full h-16 flex justify-center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">Ver alumnos con posibilidades de beca o mérito.</p>
                <p class="absolute w-full font-semibold text-amber-600 dark:text-amber-300 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">Ver Alumnos</p>
            </div>
        </a>


        <a href="/estadisticasGlobales" class="group relative flex flex-col justify-center items-center bg-purple-50 dark:bg-slate-800/80 border border-purple-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-purple-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
        <h2 class="text-2xl font-bold text-purple-700 dark:text-purple-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Reportes Estadísticos</h2>
            <div class="relative w-full h-16 flex justify-center items-center">
            <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">Consulta los promedios de aprobación de las carreras.</p>
            <p class="absolute w-full font-semibold text-purple-600 dark:text-purple-300 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">Ver Estadísticas</p>
            </div>
        </a>

    </div>
    
    <button type="button" onclick="window.location.href='/dashboard'"
            class="w-full bg-gray-300 text-gray-800 py-2 px-4 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 mt-2">
        Volver
    </button>
</div>
{{> footer}}

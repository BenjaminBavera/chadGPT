{{> header}}

<script>document.title = "Reportes y estadísticas";</script>

<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
</body>
<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl">
    <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Rendimiento Académico</h1>

    {{#username}}
        <p class="text-xl text-center text-gray-700 mb-8">¡Bienvenido/a, <span class="font-semibold text-blue-600">{{username}}</span>!</p>
    {{/username}}
    {{^username}}
        <p class="text-xl text-center text-gray-700 mb-8">¡Bienvenido/a!</p>
    {{/username}}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        
        <!-- Tarjeta: Reporte de Riesgo -->
        <div class="bg-red-50 border border-red-200 p-6 rounded-lg text-center shadow-sm">
            <h2 class="text-2xl font-bold text-red-700 mb-3">Ver Reporte de Riesgo</h2>
            <p class="text-gray-600 mb-4">Identifica estudiantes con riesgo de abandono o rezago.</p>
            <a href="/reporteRiesgo" class="inline-block bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-700 transition duration-300">Ver Reporte</a>
        </div>
        
        <!-- Tarjeta: Alumnos de Excelencia -->
        <div class="bg-amber-50 border border-amber-200 p-6 rounded-lg text-center shadow-sm">
            <h2 class="text-2xl font-bold text-amber-700 mb-3">Alumnos de Excelencia</h2>
            <p class="text-gray-600 mb-4">Ver alumnos con posibilidades de beca o mérito.</p>
            <a href="/alumnosExcelencia" class="inline-block bg-amber-600 text-white py-2 px-4 rounded-md hover:bg-amber-700 transition duration-300">Ver Alumnos</a>
        </div>
        
        <!-- Tarjeta: Estadísticas Globales -->
        <div class="bg-purple-50 border border-purple-200 p-6 rounded-lg text-center shadow-sm">
            <h2 class="text-2xl font-bold text-purple-700 mb-3">Reportes Estadísticos</h2>
            <p class="text-gray-600 mb-4">Consulta los promedios de aprobación de las carreras.</p>
            <a href="/estadisticasGlobales" class="inline-block bg-purple-600 text-white py-2 px-4 rounded-md hover:bg-purple-700 transition duration-300">Ver Estadísticas</a>
        </div>

    </div>
    
    <button type="button" onclick="window.location.href='/dashboard'"
            class="w-full bg-gray-300 text-gray-800 py-2 px-4 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 mt-2">
        Volver
    </button>
</div>
{{> footer}}
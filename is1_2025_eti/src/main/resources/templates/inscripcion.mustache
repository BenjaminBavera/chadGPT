{{> header}}

<script>document.title = "Inscripción a Materias";</script>

<div class="w-full tarjeta-moderna p-8 max-w-4xl">
    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-100 mb-8">Inscripción de Alumnos</h1>

    {{#successMessage}}
        <div class="bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
    {{/successMessage}}

    {{#errorMessage}}
        <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
    {{/errorMessage}}

    {{#sinCarrera}}
        <div class="bg-yellow-50 dark:bg-slate-800/50 p-6 rounded-md border border-yellow-200 dark:border-slate-700 mb-8">
            <h2 class="text-xl font-semibold text-yellow-900 dark:text-yellow-400 mb-4">Inscripción a Carreras</h2>
            <form action="/inscribirCarrera" method="POST" class="space-y-4">
                <select name="carrera_id" required
                        class="w-full px-4 py-2 bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 text-gray-900 dark:text-white rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500">
                    <option value="" disabled selected>-- Seleccione una carrera --</option>
                    {{#carreras}}
                        <option value="{{id}}">{{nombre}}</option>
                    {{/carreras}}
                </select>
                <button type="submit"
                        class="w-full bg-yellow-600 text-white py-2 px-4 rounded-md font-semibold hover:bg-yellow-700 transition-colors">
                    Confirmar Carrera
                </button>
            </form>
        </div>

        <div class="flex flex-col gap-2 mt-4">
            <button type="button" onclick="window.location.href='/dashboardEstudiante'"
                    class="w-full bg-gray-300 dark:bg-slate-700 text-gray-800 dark:text-gray-200 py-2 px-4 rounded-md hover:bg-gray-400 dark:hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition-colors">
                Volver
            </button>
            <div class="text-center mt-2">
                <a href="/logout" class="text-red-600 dark:text-red-400 hover:underline text-sm font-medium">Cerrar Sesión</a>
            </div>
        </div>
    {{/sinCarrera}}

    {{^sinCarrera}}
        <div class="bg-blue-50 dark:bg-slate-800/50 p-6 rounded-md border border-blue-200 dark:border-slate-700 mb-8">
            <h2 class="text-xl font-semibold text-blue-900 dark:text-blue-300 mb-4 border-b border-blue-200 dark:border-slate-600 pb-2">Mis Datos</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <p><span class="font-semibold text-gray-700 dark:text-white">Alumno:</span> <span class="text-gray-800 dark:text-gray-300">{{usuario.nombre}} {{usuario.apellido}}</span></p>
                <p><span class="font-semibold text-gray-700 dark:text-white">DNI:</span> <span class="text-gray-800 dark:text-gray-300">{{usuario.dni}}</span></p>
                <p><span class="font-semibold text-gray-700 dark:text-white">Carrera:</span> <span class="text-gray-800 dark:text-gray-300">{{plan.nombre}}</span></p>
                <p><span class="font-semibold text-gray-700 dark:text-white">Plan:</span> <span class="text-gray-800 dark:text-gray-300">{{plan.anio}}</span></p>
            </div>
        </div>

        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4 border-b border-gray-200 dark:border-slate-700 pb-2">Materias Disponibles para Inscripción (Periodo Actual)</h2>
        <div class="overflow-x-auto mb-8 border border-gray-200 dark:border-slate-700 rounded-md">
            <table class="w-full text-left border-collapse">
                <thead>
                <tr class="bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-200 text-sm">
                    <th class="p-3 border-b border-gray-300 dark:border-slate-600">Código</th>
                    <th class="p-3 border-b border-gray-300 dark:border-slate-600">Nombre de la Materia</th>
                    <th class="p-3 border-b border-gray-300 dark:border-slate-600 text-center">Acción</th>
                </tr>
                </thead>
                <tbody class="text-sm text-gray-800 dark:text-gray-300">
                {{#materiasInscribir}}
                    <tr class="hover:bg-blue-50 dark:hover:bg-slate-700/50 transition border-b border-gray-100 dark:border-slate-700">
                        <td class="p-3 font-mono text-blue-800 dark:text-blue-400">{{id}}</td>
                        <td class="p-3">{{nombre}}</td>
                        <td class="p-3 text-center">
                            <form action="/inscribir" method="POST" class="m-0">
                                <input type="hidden" name="materia_id" value="{{id}}">
                                <input type="hidden" name="plan_id" value="{{plan.id}}">
                                <button type="submit" class="bg-blue-600 text-white font-semibold py-1 px-4 rounded hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition duration-150">
                                    Inscribirse
                                </button>
                            </form>
                        </td>
                    </tr>
                {{/materiasInscribir}}
                {{^materiasInscribir}}
                    <tr>
                        <td colspan="3" class="p-6 text-center text-gray-500 dark:text-gray-400 italic">
                            No hay materias disponibles para inscripción que cumplan con las correlatividades y pertenezcan a tu plan.
                        </td>
                    </tr>
                {{/materiasInscribir}}
                </tbody>
            </table>
        </div>

        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4 border-b border-gray-200 dark:border-slate-700 pb-2">Mis Inscripciones Actuales</h2>
        <div class="overflow-x-auto mb-8 border border-gray-200 dark:border-slate-700 rounded-md">
            <table class="w-full text-left border-collapse">
                <thead>
                <tr class="bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-200 text-sm">
                    <th class="p-3 border-b border-gray-300 dark:border-slate-600">Código</th>
                    <th class="p-3 border-b border-gray-300 dark:border-slate-600">Nombre de la Materia</th>
                    <th class="p-3 border-b border-gray-300 dark:border-slate-600">Año / Periodo</th>
                </tr>
                </thead>
                <tbody class="text-sm text-gray-800 dark:text-gray-300">
                {{#materiasMatriculadas}}
                    <tr class="hover:bg-green-50 dark:hover:bg-slate-700/50 transition border-b border-gray-100 dark:border-slate-700">
                        <td class="p-3 font-mono text-green-800 dark:text-green-400">{{id}}</td>
                        <td class="p-3">{{nombre}}</td>
                        <td class="p-3 text-gray-600 dark:text-gray-400">
                            {{#anio_cursado}}{{anio_cursado}}° año{{/anio_cursado}}
                            {{#cuatrimestre}} — {{cuatrimestre}}° cuat.{{/cuatrimestre}}
                        </td>
                    </tr>
                {{/materiasMatriculadas}}
                {{^materiasMatriculadas}}
                    <tr>
                        <td colspan="3" class="p-6 text-center text-gray-500 dark:text-gray-400 italic">
                            No estás inscrito en ninguna materia todavía.
                        </td>
                    </tr>
                {{/materiasMatriculadas}}
                </tbody>
            </table>
        </div>

        <div class="flex flex-col gap-2 mt-6">
            <button type="button" onclick="window.location.href='/dashboardEstudiante'"
                    class="w-full bg-gray-300 dark:bg-slate-700 text-gray-800 dark:text-gray-200 py-2 px-4 rounded-md hover:bg-gray-400 dark:hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition-colors">
                Volver
            </button>
            <div class="text-center mt-2">
                <a href="/logout" class="text-red-600 dark:text-red-400 hover:underline text-sm font-medium">Cerrar Sesión</a>
            </div>
        </div>
    {{/sinCarrera}}

</div>
{{> footer}}
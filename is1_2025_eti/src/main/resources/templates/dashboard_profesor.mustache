{{> header}}

<script>document.title = "Portal del Profesor";</script>

<div class="w-full tarjeta-moderna p-8 max-w-4xl">
    <h1 class="text-3xl font-bold text-center text-blue-900 dark:text-blue-200 mb-6">Portal del Profesor</h1>

    {{#username}}
        <p class="bienvenida text-xl text-center text-gray-700 mb-8">¡Bienvenido/a, <span class="font-semibold text-blue-600">{{username}}</span>!</p>
    {{/username}}
    {{^username}}
        <p class="bienvenida text-xl text-center text-gray-700 mb-8">¡Bienvenido/a!</p>
    {{/username}}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-teal-50 border border-teal-200 p-6 rounded-lg text-center shadow-sm hover:shadow-md transition">
            <h2 class="text-2xl font-bold text-teal-800 mb-3">Materias Asignadas</h2>
            <p class="text-gray-600 mb-4">Mira las materias que tienes asignadas.</p>

{{> header}}

<script>document.title = "Vincular Profesores";</script>


<div class="w-full tarjeta-moderna p-8 max-w-3xl">
    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-100 mb-6">Vincular Profesores</h1>

    {{#successMessage}}
        <div class="bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
    {{/successMessage}}

    {{#errorMessage}}
        <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
    {{/errorMessage}}

    <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">Vincular Materia a Profesor</h2>
        <form action="/vincularProfesores" method="post" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700 dark:text-gray-200 mb-8">
                <div>
                    <label for="profesor_id" class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Asignar al Profesor:</label>
                    <select id="profesor_id" name="profesor_id" required
                            class="w-full px-4 py-2 bg-white dark:bg-slate-800 text-gray-900 dark:text-white border border-gray-300 dark:border-slate-600 p-2 rounded focus:ring-2 focus:ring-blue-400">
                        <option value="" disabled selected>-- Seleccione un Profesor--</option>
                        {{#profesores}}
                            <option value="{{id}}">{{nombre}} ({{apellido}})</option>
                        {{/profesores}}
                    </select>
                </div>
            <div>
                <label for="materia_id" class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Materia:</label>
                <select id="materia_id" name="materia_id" required
                        class="w-full px-4 py-2 bg-white dark:bg-slate-800 text-gray-900 dark:text-white border border-gray-300 dark:border-slate-600 p-2 rounded focus:ring-2 focus:ring-blue-400">
                    <option value="" disabled selected>-- Seleccione una Materia:--</option>
                    {{#materias}}
                        <option value="{{id}}">{{nombre}} ({{codigo}})</option>
                    {{/materias}}
                </select>
            </div>
            </div>
            <div>
                <label for="cargo" class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Cargo:</label>
                <select id="cargo" name="cargo" required
                        class="w-full px-4 py-2 bg-white dark:bg-slate-800 text-gray-900 dark:text-white border border-gray-300 dark:border-slate-600 p-2 rounded focus:ring-2 focus:ring-blue-400">
                    <option value="" disabled selected>-- Seleccione un Cargo:--</option>
                    <option value="Responsable de Cátedra"> Responsable de Cátedra</option>
                    <option value="Jefe Trabajos Prácticos"> Jefe Trabajos Prácticos</option>
                    <option value="Ayudante"> Ayudante</option>
                </select>
            </div>
            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                Guardar vinculación
            </button>
        </form>
    </div>

    <button type="button" onclick="window.location.href='/dashboardAcademico'"
            class="w-full bg-gray-300 text-gray-800 py-2 px-4 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 mt-2">
        Volver
    </button>
    <div class="text-center mt-4">
        <a href="/" class="text-blue-600 hover:underline text-sm">Cerrar Sesión</a>
    </div>

</div>
{{> footer}}
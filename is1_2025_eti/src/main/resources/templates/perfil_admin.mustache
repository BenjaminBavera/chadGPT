{{> header}}

<script>document.title = "Mi Perfil";</script>

<div class="w-full tarjeta-moderna p-8 max-w-xl">

    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-100 mb-8">Mi Perfil</h1>

    {{#message}}
        <div class="bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded mb-6">
            {{message}}
        </div>
    {{/message}}
    {{#error}}
        <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded mb-6">
            {{error}}
        </div>
    {{/error}}

    <div class="bg-blue-50 dark:bg-slate-800/50 p-6 rounded-md border border-blue-200 dark:border-slate-700 mb-6">
        <h2 class="text-xl font-semibold text-blue-900 dark:text-blue-300 mb-4 border-b border-blue-200 dark:border-slate-600 pb-2">
            Mis Datos
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700 dark:text-gray-200">
            <p><span class="font-semibold text-gray-800 dark:text-white">Nombre:</span> {{usuario.nombre}} {{usuario.apellido}}</p>
            <p><span class="font-semibold text-gray-800 dark:text-white">Usuario:</span> {{usuario.username}}</p>
            <p><span class="font-semibold text-gray-800 dark:text-white">DNI:</span> {{usuario.dni}}</p>
            <p><span class="font-semibold text-gray-800 dark:text-white">Teléfono:</span> {{usuario.telefono}}</p>
        </div>
    </div>

    <div class="bg-gray-50 dark:bg-slate-800/50 p-6 rounded-md border border-gray-200 dark:border-slate-700 mb-8">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-4 border-b border-gray-200 dark:border-slate-600 pb-2">
            Cambiar Contraseña
        </h2>
        <form action="/cambiarPasswordAdmin" method="POST" class="space-y-4">
            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Contraseña actual:</label>
                <input type="password" name="actual" required
                       class="w-full px-4 py-2 bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 text-gray-900 dark:text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Nueva contraseña:</label>
                <input type="password" name="nueva" required
                       class="w-full px-4 py-2 bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 text-gray-900 dark:text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md font-semibold hover:bg-blue-700 transition-colors">
                Actualizar Contraseña
            </button>
        </form>
    </div>

    <button type="button" onclick="window.location.href='/dashboard'"
            class="w-full bg-gray-300 dark:bg-slate-700 text-gray-800 dark:text-gray-200 py-2 px-4 rounded-md hover:bg-gray-400 dark:hover:bg-slate-600 transition-colors">
        Volver
    </button>

</div>

{{> footer}}
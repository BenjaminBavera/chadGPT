{{> header}}

<script>document.title = "Mi Perfil";</script>

<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
</body>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl my-8">

    <h1 class="text-3xl font-bold text-center text-gray-800 mb-8">Mi Perfil</h1>

    {{#message}}
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">{{message}}</div>
    {{/message}}
    {{#error}}
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">{{error}}</div>
    {{/error}}

    <div class="bg-blue-50 p-6 rounded-md border border-blue-200 mb-8">
        <h2 class="text-xl font-semibold text-blue-900 mb-4 border-b border-blue-200 pb-2">Mis Datos</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <p><span class="font-semibold text-gray-700">Nombre:</span> {{usuario.nombre}} {{usuario.apellido}}</p>
            <p><span class="font-semibold text-gray-700">Usuario:</span> {{usuario.username}}</p>
            <p><span class="font-semibold text-gray-700">DNI:</span> {{usuario.dni}}</p>
            <p><span class="font-semibold text-gray-700">Telefono:</span> {{usuario.telefono}}</p>
        </div>
    </div>

    <div class="bg-gray-50 p-6 rounded-md border border-gray-200 mb-8">
        <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2">Cambiar Contrasena</h2>
        <form action="/cambiarPasswordAdmin" method="POST" class="space-y-4">
            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">Contrasena actual:</label>
                <input type="password" name="actual" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">Nueva contrasena:</label>
                <input type="password" name="nueva" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md font-semibold hover:bg-blue-700">
                Actualizar Contrasena
            </button>
        </form>
    </div>

    <button type="button" onclick="window.location.href='/dashboard'"
            class="w-full bg-gray-300 text-gray-800 py-2 px-4 rounded-md hover:bg-gray-400">
        Volver
    </button>

</div>
{{> footer}}
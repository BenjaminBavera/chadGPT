{{> header}}

<script>document.title = "Gestión de Correlatividades";</script>

<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
</body>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">

<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl my-8">
    <h1 class="text-3xl font-bold text-center text-gray-800 mb-2">Gestión de Correlatividades</h1>
    <p class="text-center text-gray-600 mb-6">Establecé qué materias son requisitos para cursar otras.</p>

    {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
    {{/successMessage}}

    {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
    {{/errorMessage}}

    <div class="bg-gray-50 p-6 rounded-md border border-gray-200 mb-8">
        <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2">Asignar Nueva Correlativa</h2>
        
        <form action="/asignarCorrelativa" method="post" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                
                <div>
                    <label for="materia_codigo" class="block text-gray-700 text-sm font-medium mb-1">Materia a cursar:</label>
                    <select id="materia_codigo" name="materia_codigo" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                        <option value="" disabled selected>-- Seleccionar Materia --</option>
                        {{#materias}}
                            <option value="{{id}}">{{nombre}}</option>
                        {{/materias}}
                    </select>
                </div>

                <div>
                    <label for="correlativa_codigo" class="block text-gray-700 text-sm font-medium mb-1">Requiere haber hecho:</label>
                    <select id="correlativa_codigo" name="correlativa_codigo" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                        <option value="" disabled selected>-- Seleccionar Requisito --</option>
                        {{#materias}}
                            <option value="{{id}}">{{nombre}}</option>
                        {{/materias}}
                    </select>
                </div>

                <div>
                    <label for="tipo" class="block text-gray-700 text-sm font-medium mb-1">Condición requerida:</label>
                    <select id="tipo" name="tipo" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                        <option value="regular">Tenerla Regular</option>
                        <option value="aprobada">Tenerla Aprobada (Final)</option>
                    </select>
                </div>

            </div>

            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-semibold mt-4">
                Guardar Correlatividad
            </button>
        </form>
    </div>

    <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2">Sistema de Correlatividades Actual</h2>
    <div class="overflow-x-auto mb-6 bg-white border border-gray-200 rounded-md shadow-sm">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-100 text-gray-700 text-sm uppercase tracking-wide">
                    <th class="p-3 border-b border-gray-300">Materia</th>
                    <th class="p-3 border-b border-gray-300">Requisito Previo</th>
                    <th class="p-3 border-b border-gray-300">Condición</th>
                    <th class="p-3 border-b border-gray-300 text-center">Acción</th>
                </tr>
            </thead>
            <tbody class="text-sm text-gray-800">
                {{#correlatividades}}
                <tr class="hover:bg-gray-50 border-b border-gray-100">
                    <td class="p-3 font-medium text-blue-800">{{materia_nombre}}</td>
                    <td class="p-3">{{correlativa_nombre}}</td>
                    <td class="p-3">
                        <span class="px-2 py-1 text-xs font-semibold rounded-full 
                            {{#esAprobada}}bg-green-100 text-green-800{{/esAprobada}}
                            {{^esAprobada}}bg-yellow-100 text-yellow-800{{/esAprobada}}">
                            {{tipo}}
                        </span>
                    </td>
                    <td class="p-3 text-center">
                        <form action="/eliminarCorrelativa" method="POST" class="inline">
                            <input type="hidden" name="materia_codigo" value="{{materia_codigo}}">
                            <input type="hidden" name="correlativa_codigo" value="{{correlativa_codigo}}">
                            <button type="submit" class="text-red-600 hover:text-red-800 font-medium transition"
                                    onclick="return confirm('¿Eliminar esta correlatividad?')">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
                {{/correlatividades}}
                {{^correlatividades}}
                <tr>
                    <td colspan="4" class="p-6 text-center text-gray-500">No hay correlatividades registradas en el sistema.</td>
                </tr>
                {{/correlatividades}}
            </tbody>
        </table>
    </div>

    <button type="button" onclick="window.location.href='/dashboardAcademico'"
            class="w-full bg-gray-300 text-gray-800 py-2 px-4 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition font-medium">
        Volver a Gestión Académica
    </button>
</div>
{{> footer}}
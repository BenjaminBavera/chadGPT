{{> header}}

<script>document.title = "Portal del Estudiante";</script>

<div class="w-full tarjeta-moderna p-8 max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-200 mb-6">Portal del Estudiante</h1>

    {{#username}}
        <p class="bienvenida text-xl text-center text-gray-700 dark:text-gray-300 mb-8">
            ¡Bienvenido/a, <span class="font-semibold text-blue-600 dark:text-blue-400">{{username}}</span>!
        </p>
    {{/username}}
    {{^username}}
        <p class="bienvenida text-xl text-center text-gray-700 dark:text-gray-300 mb-8">
            ¡Bienvenido/a!
        </p>
    {{/username}}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

        <a href="/inscripcion" class="group relative flex flex-col justify-center items-center bg-teal-50 dark:bg-slate-800/80 border border-teal-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-teal-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
            <h2 class="text-2xl font-bold text-teal-700 dark:text-teal-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Inscripción a Materias</h2>
            <div class="relative w-full h-16 flex justify-center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">Anotate en las materias disponibles para cursar este cuatrimestre.</p>
                <p class="absolute w-full font-semibold text-teal-700 dark:text-teal-300 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">Ir a Inscripción</p>
            </div>
        </a>

        <a href="/estadoAcademico" class="group relative flex flex-col justify-center items-center bg-blue-50 dark:bg-slate-800/80 border border-blue-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-blue-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
            <h2 class="text-2xl font-bold text-blue-700 dark:text-blue-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Mi Estado Académico</h2>
            <div class="relative w-full h-16 flex justify-center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">Revisá tus notas, materias aprobadas y plan de estudio.</p>
                <p class="absolute w-full font-semibold text-blue-700 dark:text-blue-400 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">Ver Estado</p>
            </div>
        </a>

        <a href="/perfil" class="md:col-span-2 md:w-1/2 md:mx-auto group relative flex flex-col justify-center items-center bg-purple-50 dark:bg-slate-800/80 border border-purple-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-purple-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[160px] overflow-hidden cursor-pointer">
            <h2 class="text-xl font-bold text-purple-700 dark:text-purple-400 mb-1 transform transition-transform duration-300 group-hover:-translate-y-2">Mi Perfil</h2>
            <div class="relative w-full h-12 flex justify-center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">Gestioná tus datos y contraseña.</p>
                <p class="absolute w-full font-semibold text-purple-700 dark:text-purple-400 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">Ir a Perfil</p>
            </div>
        </a>
    </div>
</div>

<div class="w-full flex justify-center mt-2">
    <a href="/logout" class="bg-red-600 text-white py-2 px-8 rounded-md hover:bg-red-700 transition duration-300 text-lg font-medium">
        Cerrar Sesión
    </a>
</div>

{{> footer}}
{{> header}}

<script>document.title = "Inscriptos por Materia";</script>

<div class="w-full tarjeta-moderna p-8 max-w-4xl">

    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-100 mb-8">Inscriptos por Materia</h1>

    {{#message}}
    <div class="bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded mb-6">{{message}}</div>
    {{/message}}
    {{#error}}
    <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded mb-6">{{error}}</div>
    {{/error}}

    <div class="overflow-x-auto border border-gray-200 rounded-md mb-6">
        <table class="w-full text-left bg-white">
            <thead>
            <tr class="bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-200 text-sm">
                <th class="p-3 border-b border-gray-300 dark:border-slate-600">ID</th>
                <th class="p-3 border-b border-gray-300 dark:border-slate-600">Materia</th>
                <th class="p-3 border-b border-gray-300 dark:border-slate-600 text-center">Cupo</th>
                <th class="p-3 border-b border-gray-300 dark:border-slate-600 text-center">Inscriptos</th>
                <th class="p-3 border-b border-gray-300 dark:border-slate-600 text-center">Disponibles</th>
                <th class="p-3 border-b border-gray-300 dark:border-slate-600 text-center">Accion</th>
            </tr>
            </thead>
            <tbody class="text-sm text-gray-800 dark:text-gray-300">
            {{#materias}}
            <tr class="hover:bg-gray-100 dark:hover-slate-600 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-700">
                <td class="p-3 font-mono">{{id}}</td>
                <td class="p-3 font-medium">{{nombre}}</td>
                <td class="p-3 text-center">{{cupo}}</td>
                <td class="p-3 text-center">{{inscriptos}}</td>
                <td class="p-3 text-center">{{disponibles}}</td>
                <td class="p-3 text-center">
                    <a href="/inscriptosPorMateria/{{id}}"
                       class="bg-blue-600 text-white py-1 px-3 rounded hover:bg-blue-700 text-xs font-semibold">
                        Ver detalle
                    </a>
                </td>
            </tr>
            {{/materias}}
            {{^materias}}
            <tr>
                <td colspan="6" class="p-6 text-center text-gray-500 italic">No hay materias cargadas.</td>
            </tr>
            {{/materias}}
            </tbody>
        </table>
    </div>

    <button type="button" onclick="window.location.href='/dashboardAcademico'"
            class="w-full bg-gray-300 text-gray-800 py-2 px-4 rounded-md hover:bg-gray-400">
        Volver
    </button>

</div>
{{> footer}}
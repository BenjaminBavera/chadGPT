{{> header}}

<script>document.title = "Inscriptos por Materia";</script>

<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
</body>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl my-8">

    <h1 class="text-3xl font-bold text-center text-gray-800 mb-8">Inscriptos por Materia</h1>

    {{#message}}
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">{{message}}</div>
    {{/message}}
    {{#error}}
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">{{error}}</div>
    {{/error}}

    <div class="overflow-x-auto border border-gray-200 rounded-md mb-6">
        <table class="w-full text-left bg-white">
            <thead>
            <tr class="bg-gray-100 text-gray-700 text-sm">
                <th class="p-3 border-b">ID</th>
                <th class="p-3 border-b">Materia</th>
                <th class="p-3 border-b text-center">Cupo</th>
                <th class="p-3 border-b text-center">Inscriptos</th>
                <th class="p-3 border-b text-center">Disponibles</th>
                <th class="p-3 border-b text-center">Accion</th>
            </tr>
            </thead>
            <tbody class="text-sm">
            {{#materias}}
            <tr class="border-b hover:bg-gray-50">
                <td class="p-3 font-mono">{{id}}</td>
                <td class="p-3 font-medium">{{nombre}}</td>
                <td class="p-3 text-center">{{cupo}}</td>
                <td class="p-3 text-center">{{inscriptos}}</td>
                <td class="p-3 text-center">{{disponibles}}</td>
                <td class="p-3 text-center">
                    <a href="/inscriptosPorMateria/{{id}}"
                       class="bg-blue-600 text-white py-1 px-3 rounded hover:bg-blue-700 text-xs font-semibold">
                        Ver detalle
                    </a>
                </td>
            </tr>
            {{/materias}}
            {{^materias}}
            <tr>
                <td colspan="6" class="p-6 text-center text-gray-500 italic">No hay materias cargadas.</td>
            </tr>
            {{/materias}}
            </tbody>
        </table>
    </div>

    <button type="button" onclick="window.location.href='/dashboardAcademico'"
            class="w-full bg-gray-300 text-gray-800 py-2 px-4 rounded-md hover:bg-gray-400">
        Volver
    </button>

</div>
{{> footer}}
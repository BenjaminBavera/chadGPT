        <a href="/registrarProfesor" class="group relative flex flex-col justify-center items-center bg-indigo-50 dark:bg-slate-800/80 border border-indigo-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-indigo-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">

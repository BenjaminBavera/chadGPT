{{> header}}

<script>document.title = "Registrar Administrador";</script>

<div class="w-full tarjeta-moderna p-8 max-w-xl">
    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-100 mb-6">Nuevo Administrador de Sistema</h1>

    {{#successMessage}}
        <div class="bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
    {{/successMessage}}

    {{#errorMessage}}
        <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
    {{/errorMessage}}

    <form action="/admin/new" method="post" class="space-y-6">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700 dark:text-gray-200">
            <div>
                <label for="username" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Nombre de Usuario:</label>
                <input type="text" id="username" name="username" required
                       class="w-full px-4 py-2 bg-white dark:bg-slate-800 text-gray-900 dark:text-white border border-gray-300 dark:border-slate-600 p-2 rounded focus:ring-2 focus:ring-blue-400">
            </div>
            <div>
                <label for="password" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Contraseña:</label>
                <input type="password" id="password" name="password" required
                       class="w-full px-4 py-2 bg-white dark:bg-slate-800 text-gray-900 dark:text-white border border-gray-300 dark:border-slate-600 p-2 rounded focus:ring-2 focus:ring-blue-400">
            </div>
        </div>

        <hr class="border-gray-200">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 dark:text-gray-200">
            <div>
                <label for="nombre" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Nombre:</label>
                <input type="text" id="nombre" name="nombre" required
                       class="w-full px-4 py-2 bg-white dark:bg-slate-800 text-gray-900 dark:text-white border border-gray-300 dark:border-slate-600 p-2 rounded focus:ring-2 focus:ring-blue-400">
            </div>
            <div>
                <label for="apellido" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Apellido:</label>
                <input type="text" id="apellido" name="apellido" required
                       class="w-full px-4 py-2 bg-white dark:bg-slate-800 text-gray-900 dark:text-white border border-gray-300 dark:border-slate-600 p-2 rounded focus:ring-2 focus:ring-blue-400">
            </div>
            <div>
                <label for="dni" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">DNI:</label>
                <input type="number" id="dni" name="dni" required min="1000000"
                       class="w-full px-4 py-2 bg-white dark:bg-slate-800 text-gray-900 dark:text-white border border-gray-300 dark:border-slate-600 p-2 rounded focus:ring-2 focus:ring-blue-400">
            </div>
            <div>
                <label for="telefono" class="block text-gray-700 dark:text-gray-300 text-sm font-medium mb-1">Teléfono (Opcional):</label>
                <input type="text" id="telefono" name="telefono"
                       class="w-full px-4 py-2 bg-white dark:bg-slate-800 text-gray-900 dark:text-white border border-gray-300 dark:border-slate-600 p-2 rounded focus:ring-2 focus:ring-blue-400">
            </div>
        </div>

        <button type="submit"
                class="w-full bg-blue-800 text-white py-2 px-4 rounded-md font-semibold hover:bg-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors">
            Registrar Administrador
        </button>
        <div class="text-center mt-4">
            <a href="/gestionUsuario" class="text-blue-600 hover:underline text-sm font-medium">Volver</a>
        </div>
    </form>
</div>
{{> footer}}
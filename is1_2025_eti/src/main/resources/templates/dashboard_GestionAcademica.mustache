{{> header}}

<script>document.title = "Gestión Académica";</script>


<div class="w-full tarjeta-moderna p-8 max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-200 mb-6">Gestión Académica</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-gray-700 dark:text-gray-200 mb-8">

        <a href="/crearCarrera" class="group relative flex flex-col justify-center items-center bg-indigo-50 dark:bg-slate-800/80 border border-indigo-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-indigo-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
            <h2 class="text-2xl font-bold text-indigo-700 dark:text-indigo-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Gestión de Carreras</h2>
            <div class="relative w-full h-16 flex justify-center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">Crea carreras y asígnale sus respectivos planes y materias.</p>
                <p class="absolute w-full font-semibold text-indigo-600 dark:text-indigo-300 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">Gestionar carreras</p>
            </div>
        </a>


        <a href="/vincularProfesores" class="group relative flex flex-col justify-center items-center bg-rose-50 dark:bg-slate-800/80 border border-rose-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-rose-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
            <h2 class="text-2xl font-bold text-rose-700 dark:text-rose-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Vincular Profesores</h2>
            <div class="relative w-full h-16 flex justify-center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">Vincula profesores a materias y cátedras.</p>
                <p class="absolute w-full font-semibold text-rose-600 dark:text-rose-300 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">Vincular profesores</p>
            </div>
        </a>

        <a href="/inscriptosPorMateria" class="group relative flex flex-col justify-center items-center bg-purple-50 dark:bg-slate-800/80 border border-purple-200 dark:border-slate-700 p-6 rounded-lg text-center shadow-sm hover:shadow-md hover:bg-purple-100 dark:hover:bg-slate-700 transition-all duration-300 min-h-[220px] overflow-hidden cursor-pointer">
            <h2 class="text-2xl font-bold text-purple-700 dark:text-purple-400 mb-2 transform transition-transform duration-300 group-hover:-translate-y-2">Inscriptos por Materia</h2>
            <div class="relative w-full h-16 flex justify-center items-center">
                <p class="absolute w-full text-gray-600 dark:text-gray-300 transition-all duration-300 opacity-100 group-hover:opacity-0 group-hover:translate-y-4 px-4">Supervisa los inscriptos y cupos de cada materia.</p>
                <p class="absolute w-full font-semibold text-purple-600 dark:text-purple-300 transition-all duration-300 opacity-0 -translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 px-4">Ver inscriptos</p>
            </div>
        </a>

    </div>


    <div class="bg-gray-50 p-6 rounded-md border border-gray-200 mb-8 flex flex-col md:flex-row items-center justify-between shadow-sm dark:bg-slate-800/80 dark:border-slate-700">
        <div class="text-center md:text-left mb-4 md:mb-0">
            <h2 class="text-xl font-semibold text-gray-800 mb-1 dark:text-gray-100 ">Período de Inscripciones</h2>
            <p class="text-gray-600 dark:text-gray-100">
                Estado actual:
                {{#inscripcionesAbiertas}}
                    <span class="text-green-700 font-bold bg-green-100 px-3 py-1 rounded-full ml-1 text-sm border border-green-300">Abierto</span>
                {{/inscripcionesAbiertas}}
                {{^inscripcionesAbiertas}}
                    <span class="text-red-700 font-bold bg-red-100 px-3 py-1 rounded-full ml-1 text-sm border border-red-300">Cerrado</span>
                {{/inscripcionesAbiertas}}
            </p>
        </div>

        <form action="/toggleInscripciones" method="POST">
            {{#inscripcionesAbiertas}}
                <button type="submit"
                        class="bg-red-600 text-white py-2 px-6 rounded-md hover:bg-red-700 font-semibold transition duration-300 shadow-sm focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
                    Cerrar Inscripciones
                </button>
            {{/inscripcionesAbiertas}}
            {{^inscripcionesAbiertas}}
                <button type="submit"
                        class="bg-green-600 text-white py-2 px-6 rounded-md hover:bg-green-700 font-semibold transition duration-300 shadow-sm focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
                    Abrir Inscripciones
                </button>
            {{/inscripcionesAbiertas}}
        </form>
    </div>


    <button type="button" onclick="window.location.href='/dashboard'"
            class="w-full bg-gray-300 text-gray-800 py-2 px-4 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 mt-2">
        Volver
    </button>
</div>
{{> footer}}
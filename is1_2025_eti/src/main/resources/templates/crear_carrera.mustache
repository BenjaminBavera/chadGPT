{{> header}}
<script>document.title = "Gestión de Carreras";</script>

<div class="w-full tarjeta-moderna p-8 max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-100 mb-6">Gestión de Carreras y Materias</h1>

    {{#successMessage}}
        <div class="bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
    {{/successMessage}}
    {{#errorMessage}}
        <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
    {{/errorMessage}}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm">
            <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">1. Crear Carrera</h2>
            <form action="/crearCarrera/new" method="post" class="space-y-4">
                <div>
                    <label class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Nombre:</label>
                    <input type="text" name="nombre" required placeholder="Ej: Analista en Computación"
                           class="w-full px-4 py-2 bg-white dark:bg-slate-900 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-600 rounded outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-md hover:bg-blue-700 transition">Guardar Carrera</button>
            </form>
        </div>

        <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm">
            <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">2. Crear Plan</h2>
            <form action="/crearPlan/new" method="post" class="space-y-4">
                <div>
                    <label class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Carrera:</label>
                    <select name="carrera_id" required class="w-full px-4 py-2 bg-white dark:bg-slate-900 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-600 rounded outline-none">
                        <option value="" disabled selected>-- Seleccione una Carrera --</option>
                        {{#carreras}}<option value="{{id}}">{{nombre}}</option>{{/carreras}}
                    </select>
                </div>
                <div>
                    <label class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Año:</label>
                    <input type="number" name="anio" required placeholder="Ej: 2024" class="w-full px-4 py-2 bg-white dark:bg-slate-900 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-600 rounded outline-none">
                </div>
                <button type="submit" class="w-full bg-indigo-600 text-white py-2 rounded-md hover:bg-indigo-700 transition">Crear Plan</button>
            </form>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm mb-8">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">3. Crear Materia y Vincular a Plan</h2>
        <form action="/crearMateria/new" method="post" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Asignar al Plan:</label>
                    <select name="plan_id" required class="w-full px-4 py-2 bg-white dark:bg-slate-900 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-600 rounded outline-none">
                        <option value="" disabled selected>-- Seleccione un Plan --</option>
                        {{#planes}}<option value="{{id}}">Plan {{anio}} - {{carreraNombre}}</option>{{/planes}}
                    </select>
                </div>
                <div>
                    <label class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Nombre Materia:</label>
                    <input type="text" name="nombre" required placeholder="Ej: Ingeniería de Software" class="w-full px-4 py-2 bg-white dark:bg-slate-900 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-600 rounded outline-none">
                </div>
                <div>
                    <label class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Año Cursado:</label>
                    <input type="number" name="anio_cursado" required placeholder="Ej: 3" class="w-full px-4 py-2 bg-white dark:bg-slate-900 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-600 rounded outline-none">
                </div>
                <div>
                    <label class="block text-gray-600 dark:text-gray-400 text-sm font-medium mb-1">Cuatrimestre:</label>
                    <select name="cuatrimestre" class="w-full px-4 py-2 bg-white dark:bg-slate-900 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-600 rounded outline-none">
                        <option value="1">1° Cuatrimestre</option>
                        <option value="2">2° Cuatrimestre</option>
                        <option value="0">Anual</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="w-full mt-2 bg-teal-600 text-white py-2 rounded-md hover:bg-teal-700 transition">Crear y Vincular Materia</button>
        </form>
    </div>

    <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm mb-6">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4">Lista General de Materias</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                <tr class="bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-200 text-sm">
                    <th class="p-3 border-b border-gray-200 dark:border-slate-600">ID</th>
                    <th class="p-3 border-b border-gray-200 dark:border-slate-600">Nombre</th>
                    <th class="p-3 border-b border-gray-200 dark:border-slate-600">Año</th>
                    <th class="p-3 border-b border-gray-200 dark:border-slate-600">Cuat.</th>
                    <th class="p-3 border-b border-gray-200 dark:border-slate-600 text-center">Acción</th>
                </tr>
                </thead>
                <tbody class="text-sm text-gray-700 dark:text-gray-300">
                {{#materias}}
                    <tr class="border-b border-gray-100 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700/50">
                        <td class="p-3">{{id}}</td>
                        <td class="p-3 font-semibold">{{nombre}}</td>
                        <td class="p-3">{{anioCursado}}°</td>
                        <td class="p-3">{{cuatrimestre}}</td>
                        <td class="p-3 text-center">
                            <form action="/eliminarMateria" method="POST">
                                <input type="hidden" name="materia_id" value="{{id}}">
                                <button type="submit" class="text-red-500 hover:text-red-700 font-medium">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                {{/materias}}
                </tbody>
            </table>
        </div>
    </div>

    <button onclick="window.location.href='/asignarCorrelativas'" class="w-full bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 border border-indigo-300 dark:border-indigo-800 py-2 rounded-md hover:bg-indigo-200 dark:hover:bg-indigo-900/50 transition font-medium mb-2">
        Ir a Gestión de Correlatividades
    </button>
    <button onclick="window.location.href='/dashboardAcademico'" class="w-full bg-gray-200 dark:bg-slate-700 text-gray-800 dark:text-gray-200 py-2 rounded-md hover:bg-gray-300 dark:hover:bg-slate-600 transition">
        Volver
    </button>
</div>
{{> footer}}
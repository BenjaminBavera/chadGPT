{{> header}}

<script>document.title = "Reportes Académicos Institucionales";</script>

<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
</body>
<body class="bg-gray-50 min-h-screen p-8">

<div class="max-w-7xl mx-auto">
    
    <div class="mb-8 border-b pb-4 flex justify-between items-end">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Estadísticas Institucionales</h1>
            <p class="text-gray-600 mt-2">Módulo de métricas cuantitativas y seguimiento global.</p>
        </div>
        <a href="/dashboard" class="bg-indigo-600 text-white px-5 py-2 rounded shadow hover:bg-indigo-700 transition">
            Volver
        </a>
    </div>

    <h2 class="text-xl font-bold text-gray-700 mb-4">Rendimiento por Carrera</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {{#statsCarreras}}
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition">
            <h3 class="text-lg font-bold text-indigo-700 mb-2">{{carrera}}</h3>
            <div class="flex justify-between items-center mt-4">
                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wide">Población</p>
                    <p class="text-2xl font-semibold text-gray-800">{{total_estudiantes}} <span class="text-sm font-normal text-gray-500">estudiantes</span></p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-gray-500 uppercase tracking-wide">Prom. Global</p>
                    <p class="text-2xl font-bold text-gray-800">{{promedio_general}}</p>
                </div>
            </div>
        </div>
        {{/statsCarreras}}
    </div>

    <h2 class="text-xl font-bold text-gray-700 mb-4">Análisis Detallado por Materia</h2>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-100 text-gray-600 text-xs uppercase tracking-wide border-b">
                    <th class="p-4 font-semibold">Carrera</th>
                    <th class="p-4 font-semibold">Materia</th>
                    <th class="p-4 font-semibold text-center">Cursantes Históricos</th>
                    <th class="p-4 font-semibold text-center">Aprobados</th>
                    <th class="p-4 font-semibold text-center">Tasa de Aprobación</th>
                    <th class="p-4 font-semibold text-center">Promedio de Notas</th>
                </tr>
            </thead>
            <tbody class="text-gray-700 text-sm">
                {{#statsMaterias}}
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-4 text-gray-500">{{carrera}}</td>
                    <td class="p-4 font-medium text-gray-900">{{materia}}</td>
                    <td class="p-4 text-center">{{cursantes}}</td>
                    <td class="p-4 text-center">{{aprobados}}</td>
                    <td class="p-4 text-center {{color_tasa}}">{{tasa_aprobacion}}</td>
                    <td class="p-4 text-center font-mono font-medium">{{promedio_notas}}</td>
                </tr>
                {{/statsMaterias}}
            </tbody>
        </table>
    </div>

</div>

</body>
{{>footer}}
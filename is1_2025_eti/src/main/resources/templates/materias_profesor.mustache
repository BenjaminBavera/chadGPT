{{> header}}

<script>document.title = "Mis Materias Asignadas";</script>

<div class="w-full tarjeta-moderna p-8 max-w-4xl">
    <h1 class="text-3xl font-bold text-center text-blue-900 dark:text-gray-100 mb-8">Mis Materias Asignadas</h1>

    {{#message}}
        <div class="bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded mb-6">
            {{message}}
        </div>
    {{/message}}
    {{#errorMessage}}
        <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
    {{/errorMessage}}

    <div class="overflow-x-auto border border-gray-200 dark:border-slate-700 rounded-md">
        <table class="w-full text-left border-collapse">
            <thead>
            <tr class="bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-200 text-sm">
                <th class="p-3 border-b border-gray-300 dark:border-slate-600">Código</th>
                <th class="p-3 border-b border-gray-300 dark:border-slate-600">Nombre de la Materia</th>
                <th class="p-3 border-b border-gray-300 dark:border-slate-600">Mi Cargo</th>
                <th class="p-3 border-b border-gray-300 dark:border-slate-600">Plan de Estudio</th>
                <th class="p-3 border-b border-gray-300 dark:border-slate-600">Accion</th>
            </tr>
            </thead>
            <tbody class="text-sm text-gray-800 dark:text-gray-300">
            {{#materiasAsignadas}}
                <tr class="border-b hover:bg-gray-50 dark:hover:bg-slate-700/50 transition border-gray-100 dark:border-slate-700">
                    <td class="p-3 font-mono text-gray-600 dark:text-gray-400">{{id}}</td>
                    <td class="p-3 font-medium">{{materia_nombre}}</td>
                    <td class="p-3">
                    <span class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 py-1 px-2 rounded text-xs font-semibold">
                        {{cargo}}
                    </span>
                    </td>
                    <td class="p-3">
                        {{#plan_anio}}Año {{plan_anio}}{{/plan_anio}}
                        {{^plan_anio}}<span class="text-gray-500 italic">Sin plan asignado</span>{{/plan_anio}}
                    </td>
                    <td class="p-3">
                        <a href="/cargarNotas/{{id}}"
                           class="bg-teal-600 text-white py-1 px-3 rounded hover:bg-teal-700 text-xs font-semibold transition">
                            Cargar Notas
                        </a>
                    </td>
                </tr>
            {{/materiasAsignadas}}

            {{^materiasAsignadas}}
                <tr>
                    <td colspan="5" class="p-6 text-center text-gray-500 italic">
                        Aún no tenés materias asignadas a tu cargo.
                    </td>
                </tr>
            {{/materiasAsignadas}}
            </tbody>
        </table>
    </div>

    <div class="flex justify-center mt-6">
        <button type="button" onclick="window.location.href='/dashboardProfesor'"
                class="bg-gray-200 text-gray-800 font-semibold py-2 px-8 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 transition-colors">
            Volver
        </button>
    </div>
</div>
{{> footer}}
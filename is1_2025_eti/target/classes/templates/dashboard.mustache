{{> header}}
    <div class="container bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Panel de Control</h1>

        {{#username}}
        <p class="bienvenida text-xl text-center text-gray-700 mb-8">¡Bienvenido/a, <span class="font-semibold text-blue-600">{{username}}</span>!</p>
        {{/username}}
        {{^username}}
        <p class="bienvenida text-xl text-center text-gray-700 mb-8">¡Bienvenido/a!</p>
        {{/username}}

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="card bg-blue-50 border border-blue-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-blue-700 mb-3">Tu Perfil</h2>
                <p class="text-gray-600 mb-4">Gestiona la información de tu cuenta.</p>
                <a href="/profile" class="inline-block bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300">Ver Perfil</a>
            </div>
            <div class="card bg-green-50 border border-green-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-green-700 mb-3">Configuraciones</h2>
                <p class="text-gray-600 mb-4">Ajusta las preferencias de tu aplicación.</p>
                <a href="/settings" class="inline-block bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition duration-300">Configuración</a>
            </div>
            <div class="card bg-yellow-50 border border-yellow-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-yellow-700 mb-3">Gestionar Usuarios</h2>
                <p class="text-gray-600 mb-4">Crea administradores, profesores y estudiantes</p>
                <a href="/gestionUsuario" class="inline-block bg-yellow-600 text-white py-2 px-4 rounded-md hover:bg-yellow-700 transition duration-300">Registrar usuarios</a>
            </div>
        </div>

        <!-- Segunda fila centrada -->
        <div class="flex flex-wrap justify-center gap-6 mb-8">
            <div class="card bg-indigo-50 border border-indigo-200 p-6 rounded-lg text-center shadow-sm w-full md:w-72">
                <h2 class="text-2xl font-bold text-indigo-700 mb-3">Gestión Académica</h2>
                <p class="text-gray-600 mb-4">Administra carreras, materias, cupos y vinculación docente.</p>
                <a href="/dashboardAcademico" class="inline-block bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 transition duration-300">Administrar</a>
            </div>
            <div class="card bg-teal-50 border border-teal-200 p-6 rounded-lg text-center shadow-sm w-full md:w-72">
                <h2 class="text-2xl font-bold text-teal-700 mb-3">Reportes y Estadísticas</h2>
                <p class="text-gray-600 mb-4">Accede a estadísticas globales, detección de alumnos en riesgo y listados de excelencia.</p>
                <a href="/dashboardReportes" class="inline-block bg-teal-600 text-white py-2 px-4 rounded-md hover:bg-teal-700 transition duration-300">Ver Reportes</a>
            </div>
        </div>

        <div class="w-full flex justify-center mt-6">
            <a href="/logout" class="bg-red-600 text-white py-2 px-6 rounded-md hover:bg-red-700 transition duration-300 text-lg">
                Cerrar Sesión
            </a>
        </div>
    </div>
{{> footer}}